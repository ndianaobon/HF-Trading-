# ─── Application ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# "demo" = simulated balances/deposits/trades (clearly labelled in the UI)
# "live" = real money flows only through configured providers
APP_MODE=demo

# ─── Database (PostgreSQL / Supabase) ──────────────────────────
# Local dev database started by `npm run db:local` (embedded PostgreSQL on port 5433)
DATABASE_URL=postgresql://harbor:harbor_dev_only@localhost:5433/harborfinance
DIRECT_URL=postgresql://harbor:harbor_dev_only@localhost:5433/harborfinance
# Supabase example:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── Security ──────────────────────────────────────────────────
# 32+ byte random secret used for token hashing (openssl rand -hex 32)
AUTH_SECRET=change-me
# 32-byte base64 key for AES-256-GCM encryption of 2FA secrets / KYC numbers (openssl rand -base64 32)
ENCRYPTION_KEY=change-me

# ─── Market data ───────────────────────────────────────────────
# "binance" = public Binance market data (no key needed) | "disabled"
MARKET_DATA_PROVIDER=binance
MARKET_DATA_BASE_URL=https://data-api.binance.vision
NEXT_PUBLIC_MARKET_WS_URL=wss://data-stream.binance.vision

# ─── Email ─────────────────────────────────────────────────────
# "console" writes emails to the EmailOutbox table + server log (dev). "smtp" sends via SMTP.
EMAIL_PROVIDER=console
EMAIL_FROM="HarborFinance <no-reply@harborfinance.test>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Storage (KYC documents, support attachments) ──────────────
# "local" stores under ./storage (never publicly served). "supabase" uses Supabase Storage.
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=harborfinance-private

# ─── Payments ──────────────────────────────────────────────────
# "manual" = admin-configured deposit addresses + manual review
# Additional providers can be registered in lib/payments/providers.js
PAYMENT_PROVIDER=manual

# ─── Market news ───────────────────────────────────────────────
# Comma-separated HTTPS RSS feeds for the dashboard "Top Stories" card.
# Only headlines and links are shown; each story links to the publisher.
# Leave empty for the defaults (Cointelegraph, CoinDesk) or set "disabled".
NEWS_FEEDS=
