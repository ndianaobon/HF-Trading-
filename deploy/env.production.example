# Production environment — copy to /var/www/harborfinance/.env on the server
# and fill in every value marked <...>. Never commit the real file.

NEXT_PUBLIC_APP_URL=https://harborfinancetrading.com
# "live" for real customers; "demo" labels everything as simulated.
APP_MODE=live

# ─── Database ───────────────────────────────────────────────────
# Option A (recommended): PostgreSQL on the VPS
DATABASE_URL=postgresql://harbor:<db-password>@localhost:5432/harborfinance
DIRECT_URL=postgresql://harbor:<db-password>@localhost:5432/harborfinance
# Option B: Supabase — pooled (6543) and direct (5432) connection strings
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── Security ───────────────────────────────────────────────────
# New database: generate fresh values on the server:
#   openssl rand -hex 32      → AUTH_SECRET
#   openssl rand -base64 32   → ENCRYPTION_KEY
# Existing database: reuse the SAME values it was created with, or 2FA and
# KYC data stored in it can no longer be decrypted.
AUTH_SECRET=<64 hex characters>
ENCRYPTION_KEY=<base64 32-byte key>

# ─── Market data ────────────────────────────────────────────────
MARKET_DATA_PROVIDER=binance
MARKET_DATA_BASE_URL=https://data-api.binance.vision

# ─── Email (verification, password reset) ──────────────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM="HarborFinance <no-reply@harborfinancetrading.com>"
# Hostinger email: smtp.hostinger.com, port 465, the full mailbox address as user
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@harborfinancetrading.com
SMTP_PASS=<mailbox password>

# ─── Storage (KYC documents, support attachments, trader images) ─
# "local" keeps files in ./storage on the VPS (include it in backups).
STORAGE_PROVIDER=local

PAYMENT_PROVIDER=manual
NEWS_FEEDS=

# Reverse proxies in front of the app (1 = Hostinger). Client IP = this many entries from the right of X-Forwarded-For.
TRUSTED_PROXY_HOPS=1
